{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/jimeng/image_handoff.schema.json",
  "title": "Jimeng full-delivery image branch handoff v2.1",
  "type": "object",
  "required": [
    "schema_version", "execution_tier", "branch_role", "locked_semantic_hash", "shot_map_sha256",
    "status", "collections", "completed_shot_ids", "completed_source_shot_ids",
    "completed_inserted_shot_ids", "blocked_items", "artifacts", "source_duration_seconds",
    "generation_shot_map", "eating_plan", "break_plan", "units", "eating_plan_review",
    "break_plan_review", "controller_reply", "candidate_progress", "gallery_receipt"
  ],
  "properties": {
    "schema_version": {"const": "image-handoff-v2.1"},
    "execution_tier": {"const": "full_delivery"},
    "branch_role": {"const": "image"},
    "locked_semantic_hash": {"$ref": "#/$defs/sha256"},
    "shot_map_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["in_progress", "ready_for_merge", "blocked"]},
    "collections": {"$ref": "#/$defs/collections"},
    "completed_shot_ids": {"$ref": "#/$defs/shotIdsMaybeEmpty"},
    "completed_source_shot_ids": {"$ref": "#/$defs/sourceIdsMaybeEmpty"},
    "completed_inserted_shot_ids": {"$ref": "#/$defs/insertedIds"},
    "blocked_items": {"type": "array"},
    "artifacts": {"type": "array"},
    "source_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "generation_shot_map": {"type": "array", "items": {"$ref": "#/$defs/generationShot"}, "minItems": 1},
    "eating_plan": {"type": "object"},
    "break_plan": {"type": "object"},
    "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}},
    "eating_plan_review": {"$ref": "#/$defs/planReview"},
    "break_plan_review": {"$ref": "#/$defs/planReview"},
    "controller_reply": {"$ref": "#/$defs/controllerReply"},
    "candidate_progress": {"type": "array", "items": {"$ref": "#/$defs/candidateProgress"}},
    "gallery_receipt": {"$ref": "#/$defs/galleryReceipt"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timecode": {
      "type": "object",
      "required": ["start", "end", "duration"],
      "properties": {
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0},
        "duration": {"type": "number", "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "shotIds": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]+$"}, "uniqueItems": true, "minItems": 1},
    "shotIdsMaybeEmpty": {"type": "array", "items": {"type": "string", "pattern": "^S[0-9]+$"}, "uniqueItems": true},
    "sourceIds": {"type": "array", "items": {"type": "string", "pattern": "^SRC[0-9]+$"}, "uniqueItems": true, "minItems": 1},
    "sourceIdsMaybeEmpty": {"type": "array", "items": {"type": "string", "pattern": "^SRC[0-9]+$"}, "uniqueItems": true},
    "insertedIds": {"type": "array", "items": {"type": "string", "pattern": "^ADD[0-9]+$"}, "uniqueItems": true},
    "unitIds": {"type": "array", "items": {"type": "string", "pattern": "^(SRC|ADD)[0-9]+$"}, "uniqueItems": true, "minItems": 1},
    "collections": {
      "type": "object",
      "required": ["shot_ids", "source_shot_ids", "inserted_shot_ids", "unit_ids"],
      "properties": {
        "shot_ids": {"$ref": "#/$defs/shotIds"},
        "source_shot_ids": {"$ref": "#/$defs/sourceIds"},
        "inserted_shot_ids": {"$ref": "#/$defs/insertedIds"},
        "unit_ids": {"$ref": "#/$defs/unitIds"}
      },
      "additionalProperties": false
    },
    "performanceLayer": {
      "type": "object",
      "required": ["status", "source_timecode", "source_reference_frame", "observable_evidence", "confidence", "gap_reason"],
      "properties": {
        "status": {"enum": ["observed", "audible", "not_visible", "not_applicable", "template_supplement"]},
        "source_timecode": {"anyOf": [{"$ref": "#/$defs/timecode"}, {"type": "null"}]},
        "source_reference_frame": {"type": ["string", "null"]},
        "observable_evidence": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "gap_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "performanceLayers": {
      "type": "object",
      "required": ["emotion_trigger", "gaze", "facial_microreaction", "body_hand_preparation", "breath_pause", "voice_speech"],
      "properties": {
        "emotion_trigger": {"$ref": "#/$defs/performanceLayer"},
        "gaze": {"$ref": "#/$defs/performanceLayer"},
        "facial_microreaction": {"$ref": "#/$defs/performanceLayer"},
        "body_hand_preparation": {"$ref": "#/$defs/performanceLayer"},
        "breath_pause": {"$ref": "#/$defs/performanceLayer"},
        "voice_speech": {"$ref": "#/$defs/performanceLayer"}
      },
      "additionalProperties": false
    },
    "masterAsset": {
      "type": "object",
      "required": ["asset_id", "path", "sha256"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/", "minLength": 2},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "visibleFace": {
      "type": "object",
      "required": ["box_id", "face", "visibility_state", "master_asset", "visible_regions", "observable_evidence", "qa_status"],
      "properties": {
        "box_id": {"type": "string", "minLength": 1},
        "face": {"enum": ["front", "side", "top"]},
        "visibility_state": {"enum": ["fully_visible", "partially_visible", "occluded", "off_frame_partial"]},
        "master_asset": {"$ref": "#/$defs/masterAsset"},
        "visible_regions": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "observable_evidence": {"type": "string", "minLength": 1},
        "qa_status": {"const": "approved"}
      },
      "additionalProperties": false
    },
    "packagingEvidence": {
      "type": "object",
      "required": ["visible", "visible_faces"],
      "properties": {
        "visible": {"type": "boolean"},
        "visible_faces": {"type": "array", "items": {"$ref": "#/$defs/visibleFace"}}
      },
      "allOf": [
        {"if": {"properties": {"visible": {"const": true}}}, "then": {"properties": {"visible_faces": {"minItems": 1}}}},
        {"if": {"properties": {"visible": {"const": false}}}, "then": {"properties": {"visible_faces": {"maxItems": 0}}}}
      ],
      "additionalProperties": false
    },
    "generationShot": {
      "type": "object",
      "required": ["shot_id", "generation_timecode", "unit_ids", "source_shot_ids", "inserted_shot_ids"],
      "properties": {
        "shot_id": {"type": "string", "pattern": "^S[0-9]+$"},
        "generation_timecode": {"$ref": "#/$defs/timecode"},
        "unit_ids": {"$ref": "#/$defs/unitIds"},
        "source_shot_ids": {"$ref": "#/$defs/sourceIdsMaybeEmpty"},
        "inserted_shot_ids": {"$ref": "#/$defs/insertedIds"}
      },
      "additionalProperties": false
    },
    "approvedAsset": {
      "type": "object",
      "required": ["asset_id", "image_path", "sha256", "width", "height", "approval_status", "responsibility", "user_approval"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "image_path": {"type": "string", "pattern": "^/", "minLength": 2},
        "sha256": {"$ref": "#/$defs/sha256"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "approval_status": {"const": "user_approved"},
        "responsibility": {"type": "string", "minLength": 1},
        "user_approval": {"$ref": "#/$defs/userApproval"}
      },
      "additionalProperties": false
    },
    "qa": {
      "type": "object",
      "required": ["status", "observable_evidence", "six_layers_verified", "packaging_visible_faces_verified", "package_integration"],
      "properties": {
        "status": {"const": "approved"},
        "observable_evidence": {"type": "string", "minLength": 1},
        "six_layers_verified": {"const": true},
        "packaging_visible_faces_verified": {"type": "boolean"},
        "package_integration": {
          "anyOf": [
            {"$ref": "#/$defs/packageIntegration"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "userApproval": {
      "type": "object",
      "required": ["status", "display_receipt_id", "approved_at", "asset_sha256"],
      "properties": {
        "status": {"const": "user_approved"},
        "display_receipt_id": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "minLength": 1},
        "asset_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "boxMeasurement": {
      "type": "object",
      "required": ["box_id", "front_width_height_ratio", "thickness_front_ratio", "same_size_as_peer_boxes"],
      "properties": {
        "box_id": {"type": "string", "minLength": 1},
        "front_width_height_ratio": {"type": "number", "minimum": 0.95, "maximum": 1.05},
        "thickness_front_ratio": {"type": "number", "minimum": 0.25, "maximum": 0.35},
        "same_size_as_peer_boxes": {"const": true}
      },
      "additionalProperties": false
    },
    "packageIntegration": {
      "type": "object",
      "required": ["box_measurements", "scene_light_match", "contact_shadow", "edge_blend", "flat_cutout", "observable_evidence"],
      "properties": {
        "box_measurements": {"type": "array", "items": {"$ref": "#/$defs/boxMeasurement"}, "minItems": 1},
        "scene_light_match": {"const": "matched"},
        "contact_shadow": {"const": "matched"},
        "edge_blend": {"const": "matched"},
        "flat_cutout": {"const": false},
        "observable_evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "required": ["unit_id", "unit_type", "shot_id", "generation_timecode", "storyboard_description", "script_text", "source_performance_layers", "packaging_evidence", "approved_assets", "qa"],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^(SRC|ADD)[0-9]+$"},
        "unit_type": {"enum": ["source", "inserted"]},
        "shot_id": {"type": "string", "pattern": "^S[0-9]+$"},
        "source_shot_id": {"type": "string", "pattern": "^SRC[0-9]+$"},
        "inserted_shot_id": {"type": "string", "pattern": "^ADD[0-9]+$"},
        "source_timecode": {"$ref": "#/$defs/timecode"},
        "generation_timecode": {"$ref": "#/$defs/timecode"},
        "storyboard_description": {"type": "string", "minLength": 1},
        "script_text": {"type": "string", "minLength": 1},
        "insertion_rationale": {"type": "string", "minLength": 1},
        "rhythm_anchor": {"type": "string", "minLength": 1},
        "source_reference_shot_ids": {"$ref": "#/$defs/sourceIds"},
        "source_reference_frame": {"type": "string", "minLength": 1},
        "source_performance_layers": {"$ref": "#/$defs/performanceLayers"},
        "packaging_evidence": {"$ref": "#/$defs/packagingEvidence"},
        "approved_assets": {"type": "array", "items": {"$ref": "#/$defs/approvedAsset"}, "minItems": 1},
        "qa": {"$ref": "#/$defs/qa"}
      },
      "oneOf": [
        {"properties": {"unit_type": {"const": "source"}}, "required": ["source_shot_id", "source_timecode"], "not": {"required": ["inserted_shot_id"]}},
        {"properties": {"unit_type": {"const": "inserted"}}, "required": ["inserted_shot_id", "insertion_rationale", "rhythm_anchor", "source_reference_shot_ids", "source_reference_frame"], "not": {"required": ["source_shot_id", "source_timecode"]}}
      ],
      "additionalProperties": false
    },
    "reviewOccurrence": {
      "type": "object",
      "required": ["id", "unit_id", "shot_id", "status", "observable_evidence", "evidence_asset_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "unit_id": {"type": "string", "pattern": "^(SRC|ADD)[0-9]+$"},
        "shot_id": {"type": "string", "pattern": "^S[0-9]+$"},
        "mode": {"enum": ["person_present", "hands_only_product"]},
        "status": {"const": "approved"},
        "observable_evidence": {"type": "string", "minLength": 1},
        "evidence_asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "planReview": {
      "type": "object",
      "required": ["occurrences"],
      "properties": {
        "occurrences": {"type": "array", "items": {"$ref": "#/$defs/reviewOccurrence"}}
      },
      "additionalProperties": false
    },
    "controllerReply": {
      "type": "object",
      "required": ["must_inline_images", "may_only_report_path", "deliver_when_ready", "final_ready_requires_per_unit_gallery", "candidate_display_label", "gallery_unit_ids", "gallery_asset_refs"],
      "properties": {
        "must_inline_images": {"const": true},
        "may_only_report_path": {"const": false},
        "deliver_when_ready": {"const": true},
        "final_ready_requires_per_unit_gallery": {"const": true},
        "candidate_display_label": {"const": "候选/未批准"},
        "gallery_unit_ids": {"type": "array", "items": {"type": "string", "pattern": "^(SRC|ADD)[0-9]+$"}, "uniqueItems": true},
        "gallery_asset_refs": {"type": "array", "items": {"$ref": "#/$defs/galleryAssetRef"}}
      },
      "additionalProperties": false
    },
    "galleryAssetRef": {
      "type": "object",
      "required": ["unit_id", "asset_id"],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^(SRC|ADD)[0-9]+$"},
        "asset_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "galleryReceiptAssetRef": {
      "type": "object",
      "required": ["unit_id", "asset_id", "sha256"],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^(SRC|ADD)[0-9]+$"},
        "asset_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "galleryReceipt": {
      "type": "object",
      "required": ["status", "display_receipt_id", "displayed_at", "approved_at", "asset_refs"],
      "properties": {
        "status": {"const": "user_approved"},
        "display_receipt_id": {"type": "string", "minLength": 1},
        "displayed_at": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "minLength": 1},
        "asset_refs": {"type": "array", "items": {"$ref": "#/$defs/galleryReceiptAssetRef"}, "minItems": 1}
      },
      "additionalProperties": false
    },
    "candidateAsset": {
      "type": "object",
      "required": ["asset_id", "image_path", "sha256", "approval_status"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "image_path": {"type": "string", "pattern": "^/", "minLength": 2},
        "sha256": {"$ref": "#/$defs/sha256"},
        "approval_status": {"const": "candidate_unapproved"}
      },
      "additionalProperties": false
    },
    "candidateProgress": {
      "type": "object",
      "required": ["unit_id", "display_label", "candidate_asset"],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^(SRC|ADD)[0-9]+$"},
        "display_label": {"const": "候选/未批准"},
        "candidate_asset": {"$ref": "#/$defs/candidateAsset"}
      },
      "additionalProperties": false
    }
  }
}
